<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_naming_title">命名</string>
    <string name="settings_naming_summary">頂層資料夾、命名模板、衝突策略</string>
    <string name="settings_naming_top_level_folder_mode_title">頂層資料夾</string>
    <string name="settings_naming_top_level_folder_mode_auto">自動</string>
    <string name="settings_naming_top_level_folder_mode_enabled">啟用</string>
    <string name="settings_naming_top_level_folder_mode_disabled">關閉</string>
    <string name="settings_naming_top_level_folder_mode_auto_desc">只下一個條目時不額外建資料夾；一次下多個條目時，會建一層資料夾把它們收納在一起。</string>
    <string name="settings_naming_top_level_folder_mode_enabled_desc">始終為每一次下載操作包一層資料夾，適合整理同批次的多個下載項。</string>
    <string name="settings_naming_top_level_folder_mode_disabled_desc">不再額外包一層頂層資料夾，如單次下載多個條目，則會直接建立多個專案資料夾。</string>
    <string name="settings_naming_overwrite_existing">重名時直接覆蓋</string>
    <string name="settings_naming_overwrite_existing_desc">開啟後取代同名檔案，並沿用同名資料夾；關閉後自動附加序號以避免重名。</string>
    <string name="settings_naming_clean_separators">自動清理多餘連線符</string>
    <string name="settings_naming_clean_separators_desc">開啟後，會自動清理命名結果首尾多餘的空格和“-”，以解決變數缺失時檔名的冗餘。</string>
    <string name="settings_naming_single_page_number">單 P 稿件也標註編號</string>
    <string name="settings_naming_single_page_number_desc">開啟後，只有一個分 P 的稿件也會寫上 P1。關閉時只有多 P 稿件才帶編號。</string>
    <string name="settings_naming_shape_title">命名模板</string>
    <string name="settings_naming_shape_video">稿件影片</string>
    <string name="settings_naming_shape_episode">番劇 · 課程</string>
    <string name="settings_naming_shape_track">音樂</string>
    <string name="settings_naming_shape_opus">圖文</string>
    <string name="settings_naming_shape_listing">列表入口</string>
    <string name="settings_naming_shape_video_desc">稿件影片，以及收藏夾、稍後再看、使用者投稿裡的影片。</string>
    <string name="settings_naming_shape_episode_desc">番劇、國創、影視與課程的單集。</string>
    <string name="settings_naming_shape_track_desc">音訊單曲，以及歌單、使用者音訊裡的歌曲。</string>
    <string name="settings_naming_shape_opus_desc">圖文與專欄，含正文與配圖。</string>
    <string name="settings_naming_shape_listing_desc">收藏夾、稍後再看、使用者空間等入口的頂層資料夾。</string>
    <string name="settings_naming_source_default">預設</string>
    <string name="settings_naming_source_custom">已自定義</string>
    <string name="settings_naming_clear_custom">恢復本項預設</string>
    <string name="settings_naming_top_level_folder_template">頂層資料夾模板</string>
    <string name="settings_naming_top_level_folder_template_desc">適合放合集標題、資源分類、下載時間等批次級資訊。</string>
    <string name="settings_naming_item_folder_template">專案資料夾模板</string>
    <string name="settings_naming_item_folder_template_desc">控制每個下載條目的資料夾名稱。</string>
    <string name="settings_naming_file_template">檔名模板</string>
    <string name="settings_naming_file_template_desc">控制單個任務輸出檔案的基礎名稱，副檔名仍會按實際輸出型別自動追加。</string>
    <string name="settings_naming_restore_defaults">恢復預設模板</string>
    <string name="settings_naming_restore_defaults_desc">一鍵清除所有型別的自定義模板，全部回到預設命名。</string>
    <string name="settings_naming_restore_defaults_confirm_message">確定要恢復預設模板嗎？所有型別上自定義的模板都會被清除。</string>
    <string name="settings_naming_restore_defaults_confirm_action">確認恢復</string>
    <string name="settings_naming_restore_defaults_done">已恢復預設模板</string>
    <string name="settings_naming_empty_template_hint">輸入模板，或點選下面的變數按鈕快速插入。</string>
