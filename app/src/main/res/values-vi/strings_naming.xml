    <string name="settings_naming_top_level_folder_mode_auto_desc">Khi tải nhiều mục cùng lúc, một thư mục sẽ được tạo để gom chúng lại; tải một mục thì không tạo thêm thư mục.</string>
    <string name="settings_naming_top_level_folder_mode_enabled_desc">Luôn tạo một thư mục chứa cho mỗi đợt tải xuống để giữ các mục của nó lại với nhau.</string>
    <string name="settings_naming_top_level_folder_mode_disabled_desc">Không tạo thư mục cấp cao nhất. Khi tải nhiều mục cùng lúc, thư mục riêng của từng mục sẽ được tạo trực tiếp.</string>
    <string name="settings_naming_overwrite_existing">Ghi đè tệp trùng tên</string>
    <string name="settings_naming_overwrite_existing_desc">Thay thế tệp trùng tên và dùng lại thư mục hiện có. Khi tắt, thêm số để tránh trùng tên.</string>
