<resources>
    <string name="settings_naming_title">Nomenclatura</string>
    <string name="settings_naming_summary">Carpetas, plantillas de nombres de archivos y conflictos de nombres</string>
    <string name="settings_naming_top_level_folder_mode_title">Carpeta de nivel superior</string>
    <string name="settings_naming_top_level_folder_mode_auto">Automático</string>
    <string name="settings_naming_top_level_folder_mode_enabled">Activado</string>
    <string name="settings_naming_top_level_folder_mode_disabled">Desactivado</string>
    <string name="settings_naming_top_level_folder_mode_auto_desc">Crea una carpeta contenedora al descargar varios elementos a la vez. Un solo elemento no recibe una carpeta adicional.</string>
    <string name="settings_naming_top_level_folder_mode_enabled_desc">Crea siempre una carpeta contenedora para cada descarga, para agrupar los elementos de un mismo lote.</string>
    <string name="settings_naming_top_level_folder_mode_disabled_desc">No crea una carpeta contenedora. Al descargar varios elementos a la vez, se crean directamente sus carpetas individuales.</string>
    <string name="settings_naming_overwrite_existing">Sobrescribir archivos existentes</string>
    <string name="settings_naming_overwrite_existing_desc">Reemplaza los archivos con el mismo nombre y reutiliza las carpetas existentes. Si se desactiva, se añade un número para evitar nombres duplicados.</string>
    <string name="settings_naming_clean_separators">Eliminar separadores adicionales</string>
    <string name="settings_naming_clean_separators_desc">Elimina los espacios y guiones sobrantes al principio y al final de los nombres cuando las variables de la plantilla están vacías.</string>
    <string name="settings_naming_single_page_number">Numerar también los vídeos de una sola parte</string>
    <string name="settings_naming_single_page_number_desc">Añade P1 incluso cuando un vídeo tiene solo una parte. Si se desactiva, solo los vídeos con varias partes llevan número.</string>
